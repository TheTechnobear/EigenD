{
    "version": "0.2.0",
    "configurations": [
        // --- Windows MinGW / GDB configs ---
        // Requires: ms-vscode.cpptools extension, GDB installed via MSYS2 UCRT64
        // Install GDB: pacman -S mingw-w64-ucrt-x86_64-gdb
        {
            "name": "Windows: Debug eigend (MinGW GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tmp/bin/eigend.exe",
            "args": ["--stdout"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "SCons: Build (MinGW)"
        },
        {
            "name": "Windows: Debug eigend — no build (MinGW GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tmp/bin/eigend.exe",
            "args": ["--stdout"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        // --- macOS / lldb configs ---
