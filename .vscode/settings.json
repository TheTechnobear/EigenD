{
    "files.associations": {
        "*.svg": "xml",
        "*.mm": "cpp",
        "string": "cpp",
        "template": "cpp",
        "map": "cpp",
        "*.pip": "cpp"
    },
    "python.defaultInterpreterPath": "/usr/bin/python3",
