        {
            "label": "Launch: Workbench",
            "type": "shell",
            "command": "if [ -f ./tmp/app/Workbench.app/Contents/MacOS/Workbench ]; then ./tmp/app/Workbench.app/Contents/MacOS/Workbench; else echo 'Error: Workbench not found. Please build the project first.'; exit 1; fi",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
