        // --- SCons / MinGW tasks (Windows only) ---
        // These tasks invoke make through the MSYS2 UCRT64 bash shell.
        // They are no-ops on macOS/Linux where the integrated terminal is used directly.
        {
            "label": "SCons: Build (MinGW)",
            "type": "shell",
            "command": "make",
            "options": {
                "shell": {
                    "executable": "C:\\msys64\\usr\\bin\\bash.exe",
                    "args": ["--login", "-c"]
                },
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": "$gcc",
            "detail": "Build EigenD with MinGW-w64 via MSYS2 UCRT64 (Windows)"
        },
        {
            "label": "SCons: Build Single-threaded (MinGW)",
