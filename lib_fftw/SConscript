Import('env')

from SCons.Script import Dir
import os
import sys
import platform
import glob

# Determine the platform and architecture
def get_platform_config():
    """Return the appropriate config file name based on platform and architecture"""
    system = sys.platform
    machine = platform.machine().lower()
    
    if system == 'darwin':
        # macOS
        if machine in ['arm64', 'aarch64']:
            return 'config_macosx_arm64.h'
        else:
            return 'config_macosx_x86_64.h'
    elif system == 'win32':
        return 'config_windows_x86_64.h'
    elif system.startswith('linux'):
        if machine in ['arm64', 'aarch64', 'armv8']:
            return 'config_linux_arm64.h'
        else:
            return 'config_linux_x86_64.h'
    else:
        # Fallback
        if env['IS_MACOSX']:
            if env.get('IS_ARM', False):
                return 'config_macosx_arm64.h'
            else:
                return 'config_macosx_x86_64.h'
        elif env['IS_WINDOWS']:
            return 'config_windows_x86_64.h'
        elif env['IS_LINUX']:
            if env.get('IS_ARM', False):
                return 'config_linux_arm64.h'
            else:
                return 'config_linux_x86_64.h'
    
    return 'config.h'  # fallback

# Set the config file to use
config_file = get_platform_config()

