# Combine all core files
fftw_files = (kernel_files + dft_files + dft_scalar_files + dft_scalar_codelets + 
              rdft_files + rdft_scalar_files + rdft_r2cf_files + rdft_r2cb_files + 
              rdft_r2r_files + reodft_files + api_files)

# Add SIMD support files based on platform
simd_support_files = [os.path.join(fftw_base, 'simd-support', 'taint.c')]

# Platform-specific SIMD files and compiler flags
if env['IS_MACOSX']:
    # Add appropriate config include path
    env.Append(CPPDEFINES=[('HAVE_CONFIG_H', '1')])
    env.Append(CCFLAGS=['-include', config_file])
    
    # Check if we're on ARM using platform module
    is_arm = platform.machine().lower() in ['arm64', 'aarch64']
    
    if is_arm:
        # macOS ARM64 - NEON support
        fftw_dirs.extend([
            os.path.join(fftw_base, 'dft/simd'),
            os.path.join(fftw_base, 'dft/simd/common'),
            os.path.join(fftw_base, 'dft/simd/neon'),
            os.path.join(fftw_base, 'rdft/simd'),
            os.path.join(fftw_base, 'rdft/simd/common'),
            os.path.join(fftw_base, 'rdft/simd/neon')
        ])
        simd_support_files.append(os.path.join(fftw_base, 'simd-support/neon.c'))
        
        # Do NOT compile common SIMD codelets directly - they are included by neon versions
        # (The neon/*.c files include ../common/*.c with proper SIMD_HEADER defines)
        
        # Add NEON-specific files (these include common/*.c with proper SIMD_HEADER)
        neon_dft_files = glob.glob(os.path.join(fftw_base, 'dft/simd/neon/*.c'))
        neon_rdft_files = glob.glob(os.path.join(fftw_base, 'rdft/simd/neon/*.c'))
        fftw_files.extend(neon_dft_files)
        fftw_files.extend(neon_rdft_files)
    else:
        # macOS x86_64 - SSE2 support
        fftw_dirs.extend([
            os.path.join(fftw_base, 'dft/simd'),
            os.path.join(fftw_base, 'dft/simd/common'),
            os.path.join(fftw_base, 'dft/simd/sse2'),
            os.path.join(fftw_base, 'rdft/simd'),
            os.path.join(fftw_base, 'rdft/simd/common'),
            os.path.join(fftw_base, 'rdft/simd/sse2')
        ])
        simd_support_files.append(os.path.join(fftw_base, 'simd-support/sse2.c'))
        
        # Do NOT compile common SIMD codelets directly - they are included by sse2 versions
        
        # Add SSE2-specific files (these include common/*.c with proper SIMD_HEADER)
        sse2_dft_files = glob.glob(os.path.join(fftw_base, 'dft/simd/sse2/*.c'))
        sse2_rdft_files = glob.glob(os.path.join(fftw_base, 'rdft/simd/sse2/*.c'))
        fftw_files.extend(sse2_dft_files)
        fftw_files.extend(sse2_rdft_files)
        
        env.Append(CCFLAGS=['-msse2'])

if env['IS_WINDOWS']:
    env.Append(CPPDEFINES=[('HAVE_CONFIG_H', '1'), 'FFTW_DLL'])
    env.Append(CCFLAGS=['-include', config_file, '/wd4244', '/wd4305'])
    
    # Windows x86_64 - SSE2 support
    fftw_dirs.extend([
        os.path.join(fftw_base, 'dft/simd'),
        os.path.join(fftw_base, 'dft/simd/common'),
        os.path.join(fftw_base, 'dft/simd/sse2'),
        os.path.join(fftw_base, 'rdft/simd'),
        os.path.join(fftw_base, 'rdft/simd/common'),
        os.path.join(fftw_base, 'rdft/simd/sse2')
    ])
    simd_support_files.append(os.path.join(fftw_base, 'simd-support/sse2.c'))
    
    # Do NOT compile common SIMD codelets directly - they are included by sse2 versions
    
    # Add SSE2-specific files (these include common/*.c with proper SIMD_HEADER)
    sse2_dft_files = glob.glob(os.path.join(fftw_base, 'dft/simd/sse2/*.c'))
    sse2_rdft_files = glob.glob(os.path.join(fftw_base, 'rdft/simd/sse2/*.c'))
    fftw_files.extend(sse2_dft_files)
    fftw_files.extend(sse2_rdft_files)

if env['IS_LINUX']:
    env.Append(CPPDEFINES=[('HAVE_CONFIG_H', '1')])
    env.Append(CCFLAGS=['-include', config_file])
    
    # Check if we're on ARM using platform module
    is_arm = platform.machine().lower() in ['arm64', 'aarch64', 'armv8']
    
    if is_arm:
        # Linux ARM64 - NEON support
        fftw_dirs.extend([
            os.path.join(fftw_base, 'dft/simd'),
            os.path.join(fftw_base, 'dft/simd/common'),
            os.path.join(fftw_base, 'dft/simd/neon'),
            os.path.join(fftw_base, 'rdft/simd'),
            os.path.join(fftw_base, 'rdft/simd/common'),
            os.path.join(fftw_base, 'rdft/simd/neon')
        ])
        simd_support_files.append(os.path.join(fftw_base, 'simd-support/neon.c'))
        
        # Do NOT compile common SIMD codelets directly - they are included by neon versions
        
        # Add NEON-specific files (these include common/*.c with proper SIMD_HEADER)
        neon_dft_files = glob.glob(os.path.join(fftw_base, 'dft/simd/neon/*.c'))
        neon_rdft_files = glob.glob(os.path.join(fftw_base, 'rdft/simd/neon/*.c'))
        fftw_files.extend(neon_dft_files)
        fftw_files.extend(neon_rdft_files)
    else:
        # Linux x86_64 - SSE2 support
        fftw_dirs.extend([
            os.path.join(fftw_base, 'dft/simd'),
            os.path.join(fftw_base, 'dft/simd/common'),
            os.path.join(fftw_base, 'dft/simd/sse2'),
            os.path.join(fftw_base, 'rdft/simd'),
            os.path.join(fftw_base, 'rdft/simd/common'),
            os.path.join(fftw_base, 'rdft/simd/sse2')
        ])
        simd_support_files.append(os.path.join(fftw_base, 'simd-support/sse2.c'))
        
        # Do NOT compile common SIMD codelets directly - they are included by sse2 versions
        
        # Add SSE2-specific files (these include common/*.c with proper SIMD_HEADER)
        sse2_dft_files = glob.glob(os.path.join(fftw_base, 'dft/simd/sse2/*.c'))
        sse2_rdft_files = glob.glob(os.path.join(fftw_base, 'rdft/simd/sse2/*.c'))
        fftw_files.extend(sse2_dft_files)
        fftw_files.extend(sse2_rdft_files)
        
        env.Append(CCFLAGS=['-msse2'])

# Add SIMD support files to the list
fftw_files.extend(simd_support_files)

# Set include paths
env.Append(CPPPATH=fftw_dirs)

# Platform-specific compiler flags
if env['IS_MACOSX']:
    env.Append(CCFLAGS=['-Wno-unused-but-set-variable', '-Wno-unknown-pragmas'])

if env['IS_WINDOWS']:
    pass  # Already handled above

if env['IS_LINUX']:
    env.Append(CCFLAGS=['-Wno-unused-but-set-variable'])

# Build the library
env.PiSharedLibrary('pifftw3', fftw_files, package='eigend', hidden=False)
